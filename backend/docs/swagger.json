                "error": {
                    "type": "string",
                    "example": "Invalid request body-Could not find requested user"
                }
            }
        },
        "docs_user.ModifyPasswordFailureEmailNotValidResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string",
