            "type": "object",
            "properties": {
                "error": {
                    "type": "string",
                    "example": "Email not found in token-Email is not a valid string"
                }
            }
        },
        "docs_user.DeleteAccountSuccessResponse": {
            "type": "object",
            "properties": {
                "success": {
                    "type": "string",
                    "example": "Account deleted"
                }
            }
