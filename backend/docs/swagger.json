{
    "swagger": "2.0",
    "info": {
        "title": "Documentation for AREA Rest API",
        "contact": {}
    },
    "host": "localhost:8080",
    "paths": {
        "/actionsServices": {
            "get": {
                "description": "Get Retrieve Actions Services",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Services"
                ],
                "summary": "Actions Services",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/docs_service.ServiceActionsReactionsSuccessResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/docs_service.ServiceActionReactionInternalServerErrorResponse"
                        }
                    }
                }
            }
        },
        "/authentication/Google": {
            "get": {
                "description": "Get Google OAuth2 URL",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Authentication"
                ],
                "summary": "Google OAuth2",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/docs_userservice.OAuth2Response"
                        }
                    }
                }
            }
        },
        "/authentication/Spotify": {
            "get": {
                "description": "Get Spotify OAuth2 URL",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Authentication"
                ],
                "summary": "Spotify OAuth2",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/docs_userservice.OAuth2Response"
                        }
                    }
                }
            }
        },
        "/callback/{service}": {
            "get": {
                "description": "Callback for services",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Authentication"
                ],
                "summary": "Service Callback",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Service name (Google, Spotify..)",
                        "name": "service",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Authorization code given by the service",
                        "name": "code",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/docs_userservice.ServiceCallBackSuccessResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/docs_userservice.ServiceCallBackBadRequestResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/docs_userservice.ServiceCallBackInternalServerErrorResponse"
                        }
                    }
                }
            }
        },
        "/login": {
            "post": {
                "description": "User Authentication",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Users"
                ],
                "summary": "Login",
                "parameters": [
                    {
                        "description": "User credentials",
                        "name": "user",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/entities.UserCredentials"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/docs_user.LoginSuccessResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/docs_user.FailureInvalidBodyResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/docs_user.LoginFailureUnauthorizedResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/docs_user.LoginFailureTokenErrorResponse"
                        }
                    }
                }
            }
        },
        "/reactionsServices": {
            "get": {
                "description": "Get Retrieve Reactions Services",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Services"
                ],
                "summary": "Reactions Services",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/docs_service.ServiceActionsReactionsSuccessResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/docs_service.ServiceActionReactionInternalServerErrorResponse"
                        }
                    }
                }
            }
        },
        "/register": {
            "post": {
                "description": "Create user account",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Users"
                ],
                "summary": "Register",
                "parameters": [
                    {
                        "description": "User credentials",
                        "name": "user",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/entities.UserCredentials"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/docs_user.RegisterSuccessResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/docs_user.FailureInvalidBodyResponse"
                        }
                    },
                    "409": {
                        "description": "Conflict",
                        "schema": {
                            "$ref": "#/definitions/docs_user.RegisterFailureEmailAlreadyUsedResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/docs_user.FailureInternalServerErrorResponse"
                        }
                    }
                }
            }
        },
        "/user/delete-account": {
            "delete": {
                "description": "Delete the user account",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Users"
                ],
                "summary": "Delete Account",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/docs_user.DeleteAccountSuccessResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/docs_user.DeleteAccountFailureUnauthorizedResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/docs_user.DeleteAccountFailureInternalServerErrorResponse"
                        }
                    }
                }
            }
        },
        "/user/modify-password": {
            "put": {
                "description": "Modify the user password",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Users"
                ],
                "summary": "Modify Password",
                "parameters": [
                    {
                        "description": "New password of the user",
                        "name": "user",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/entities.UserModifyPassword"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/docs_user.ModifyPasswordSuccessResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/docs_user.ModifyPasswordBadRequestResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/docs_user.ModifyPasswordFailureEmailNotValidResponse"
                        }
                    },
                    "403": {
                        "description": "Forbidden",
                        "schema": {
                            "$ref": "#/definitions/docs_user.ModifyPasswordFailureOldPasswordNotValidResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/docs_user.ModifyPasswordFailureInternalServerErrorResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "docs_service.ServiceActionReactionInternalServerErrorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string",
                    "example": "Internal Server Error"
                }
            }
        },
        "docs_service.ServiceActionsReactionsExample": {
            "type": "object",
            "properties": {
                "Color": {
                    "type": "string",
                    "example": "#FFFFFF"
                },
                "Logo": {
                    "type": "string",
                    "example": "assets/logos/Google.png"
                },
                "Name": {
                    "type": "string",
                    "example": "Google"
                }
            }
        },
        "docs_service.ServiceActionsReactionsSuccessResponse": {
            "type": "object",
            "properties": {
                "services": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/docs_service.ServiceActionsReactionsExample"
                    }
                }
            }
        },
